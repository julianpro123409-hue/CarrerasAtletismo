    "views": [
      {
        "viewName": "carrera_vista",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT c.idCarrera AS idCarrera, c.nombre AS nombre, c.fecha AS fecha, COALESCE(ci.nombre, '') AS ciudad, COALESCE(p.nombre, '') AS pais, c.url AS url, c.tipoRecorrido AS tipoRecorrido, c.desnivelM AS desnivelM, c.terreno AS terreno, c.temperaturaC AS temperaturaC, c.humedad AS humedad, c.condiciones AS condiciones FROM carrera c LEFT JOIN ciudad ci ON ci.idCiudad = c.idCiudad LEFT JOIN pais p ON p.idPais = ci.idPais"
      },
      {
        "viewName": "corredor_vista",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT co.idCorredor AS idCorredor, co.nombre AS nombre, co.edad AS edad, ca.nombre AS categoria, co.idCategoria AS idCategoria FROM corredor co INNER JOIN categoria ca ON ca.idCategoria = co.idCategoria"
      }
